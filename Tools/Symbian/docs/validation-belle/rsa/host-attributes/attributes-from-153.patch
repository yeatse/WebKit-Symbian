+inline bool validOID(std::span<const uint8_t> bytes)
+{
+    if (bytes.empty() || (bytes.back() & 0x80))
+        return false;
+    bool first = true;
+    for (auto byte : bytes) {
+        if (first && byte == 0x80)
+            return false;
+        first = !(byte & 0x80);
+    }
+    return true;
+}
