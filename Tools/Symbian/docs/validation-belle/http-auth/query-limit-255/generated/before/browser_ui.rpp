STRUCT BA_RSS_SIGNATURE
    {
    LONG signature=0;
    SRLINK self;
    }
STRUCT EDWIN
    {
    LONG flags=0;
    WORD width=0;
    WORD lines=1;
    WORD maxlength=0;
 WORD default_case=0x4; WORD allowed_case_modes=0x1 | 0x2 | 0x4; WORD numeric_keymap=EAknEditorAlphanumericNumberModeKeymap; WORD allowed_input_modes=0x1 | 0x2 | 0x4 | 0x8 | 0x10 | 0x20 | 0x40 | 0x80 | 0x200; WORD default_input_mode=0x1; LLINK special_character_table=-1; WORD avkon_flags=0x000; WORD max_view_height_in_lines=0; WORD base_line_delta=0; WORD spare=0;
    }
STRUCT SECRETED
    {
    WORD num_letters=8;
    }
STRUCT CBA
 {
 LONG flags=0x01;
 WORD breadth=80;
 LLINK related_buttons=0;
    STRUCT buttons[];
 }
STRUCT CBA_BUTTON
 {
 BYTE version=0;
 WORD id=0;
    LTEXT txt="";
 LTEXT bmpfile="";
   WORD bmpid=0xffff;
    WORD bmpmask=0xffff;
 }
STRUCT DIALOG
    {
    LONG flags=0;
    LTEXT title="";
 LLINK pages=0;
    LLINK buttons=0;
    STRUCT items[];
 LLINK form=0;
    }
STRUCT DLG_LINE
    {
    WORD type;
    LTEXT prompt;
    WORD id=0;
 LONG itemflags=0;
    STRUCT control;
 LTEXT trailer="";
 LTEXT bmpfile = "" ;
 WORD bmpid = 0xffff ;
 WORD bmpmask ;
 LTEXT tooltip = "" ;
    }
STRUCT AVKON_DATA_QUERY
    {
    WORD layout;
    LTEXT label;
    STRUCT control;
    }

NAME WBUI
RESOURCE BA_RSS_SIGNATURE { signature = 4; }
RESOURCE CBA r_browser_prompt_buttons
{
    buttons =
    {
        CBA_BUTTON { id = EAknSoftkeyOk; txt = "OK"; },
        CBA_BUTTON { id = EAknSoftkeyCancel; txt = "Cancel"; }
    };
}
RESOURCE DIALOG r_browser_prompt
{
    flags = ((0x001|0x200 | 0x040 | 0x2000));
    buttons = r_browser_prompt_buttons;
    items =
    {
        DLG_LINE
        {
            type = EAknCtQuery;
            prompt = "";
            id = EGeneralQuery;
            bmpmask = 0xffff;
            control = AVKON_DATA_QUERY
            {
                layout = EDataLayoutAllowEmptyInput;
                label = "";
                control = EDWIN
                {
                    flags = 0x00010000 | 0x00040000;
                    maxlength = 4096;
                    width = 16;
                    lines = 1;
                    max_view_height_in_lines = 5;
                };
            };
        }
    };
}
RESOURCE DIALOG r_browser_auth_password
{
    flags = ((0x001|0x200 | 0x040 | 0x2000));
    buttons = r_browser_prompt_buttons;
    items =
    {
        DLG_LINE
        {
            type = EAknCtQuery;
            prompt = "";
            id = EGeneralQuery;
            bmpmask = 0xffff;
            control = AVKON_DATA_QUERY
            {
                layout = ECodeLayout;
                label = "";
                control = SECRETED { num_letters = 256; };
            };
        }
    };
}
RESOURCE CBA r_browser_popup_buttons
{
    buttons =
    {
        CBA_BUTTON { id = EAknSoftkeySelect; txt = "Select"; },
        CBA_BUTTON { id = EAknSoftkeyCancel; txt = "Cancel"; }
    };
}
