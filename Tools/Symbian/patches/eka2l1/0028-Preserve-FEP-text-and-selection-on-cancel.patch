 9 files changed, 85 insertions(+), 67 deletions(-)

diff --git a/src/emu/android/app/src/main/cpp/src/launcher.cpp b/src/emu/android/app/src/main/cpp/src/launcher.cpp
index 5bd51c0..c3d044f 100644
--- a/src/emu/android/app/src/main/cpp/src/launcher.cpp
+++ b/src/emu/android/app/src/main/cpp/src/launcher.cpp
@@ -683,8 +683,9 @@ namespace eka2l1::android {
 
     void launcher::on_finished_text_input(const std::string &text, const bool force_close) {
         if (input_complete_callback_) {
-            input_complete_callback_(common::utf8_to_ucs2(text));
+            auto callback = std::move(input_complete_callback_);
             input_complete_callback_ = nullptr;
+            callback(force_close ? std::u16string{} : common::utf8_to_ucs2(text), !force_close);
         }
     }
 
