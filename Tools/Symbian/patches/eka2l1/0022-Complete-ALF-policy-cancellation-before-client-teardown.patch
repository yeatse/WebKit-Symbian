Subject: [PATCH] Complete ALF policy cancellation before client teardown

Apply in the EKA2L1 root after 0020/0021. Dynarmic patch 0019 is separate.
Official uiaccelerator revision 773fc5e215e04584c3e00a1b1fa05c5a8c50440a:
CancelPolicyUpdates sends outer IPC 2, inner opcode 35 and the 64-bit thread
ID. Complete the matching plugin/thread subscription from outer IPC 3 before
replying, since CAlfTransitionRequest::DoCancel intentionally does nothing.

Scope pending requests by the real subscriber identity, erase before signal,
and reject dead, exited, unmapped or address-reused requesters at completion.
Unload/close release scoped pending requests. Do not confuse outer IPC 4's
plugin message ID with opcode 33: that plugin API is explicitly unsupported.
Known disabled-effects synchronous responses remain; unknown commands fail.

diff --git a/src/emu/services/include/services/audio/alf/alf.h b/src/emu/services/include/services/audio/alf/alf.h
index 5822cb37b..acd77a358 100644
--- a/src/emu/services/include/services/audio/alf/alf.h
+++ b/src/emu/services/include/services/audio/alf/alf.h
@@ -20,13 +20,22 @@
 #pragma once
 
 #include <services/framework.h>
+#include <map>
 
 namespace eka2l1 {
     class alf_streamer_session : public service::typical_session {
-        std::unique_ptr<service::ipc_context> pending_plugin_request_;
+        // A session can be shared by threads/plugins. Cancellation is scoped
+        // to the plugin and the thread that issued the policy subscription.
+        using request_key = std::pair<std::uint32_t, std::uint64_t>;
+        std::map<request_key, std::unique_ptr<service::ipc_context>> pending_policy_requests_;
+
+        void cancel_policy(std::uint32_t plugin, std::uint64_t thread);
+        void cancel_plugin(std::uint32_t plugin);
+        static void complete_cancel(std::unique_ptr<service::ipc_context>, std::uint64_t requester_uid);
 
     public:
         explicit alf_streamer_session(service::typical_server *svr, kernel::uid client_ss_uid, epoc::version client_version);
+        ~alf_streamer_session() override;
         void fetch(service::ipc_context *ctx) override;
     };
 
diff --git a/src/emu/services/src/audio/alf/alf.cpp b/src/emu/services/src/audio/alf/alf.cpp
index e3750430a..9713723ea 100644
--- a/src/emu/services/src/audio/alf/alf.cpp
+++ b/src/emu/services/src/audio/alf/alf.cpp
@@ -19,10 +19,25 @@
 
 #include <services/audio/alf/alf.h>
 #include <system/epoc.h>
+#include <kernel/thread.h>
 
 #include <utils/err.h>
 
 namespace eka2l1 {
+    // Official MAlfGfxEffectPlugin::TOp, uiaccelerator 773fc5e215e0:
+    // request=33, get=34, cancel=35. The cancellation stream is a LE int32
+    // operation followed by the caller's raw 64-bit TThreadId, without padding.
+    constexpr std::uint32_t control_policy_request = 33;
+    constexpr std::uint32_t control_policy_get = 34;
+    constexpr std::uint32_t control_policy_cancel = 35;
+
+    static std::uint64_t read_little_endian(const char *bytes, unsigned count) {
+        std::uint64_t result = 0;
+        for (unsigned index = 0; index < count; ++index)
+            result |= static_cast<std::uint64_t>(static_cast<unsigned char>(bytes[index])) << (8 * index);
+        return result;
+    }
+
     alf_streamer_server::alf_streamer_server(eka2l1::system *sys)
         : service::typical_server(sys, "alfstreamerserver") {
     }
@@ -37,39 +52,130 @@ namespace eka2l1 {
         : service::typical_session(serv, ss_id, client_version) {
     }
 
+    alf_streamer_session::~alf_streamer_session() {
+        while (!pending_policy_requests_.empty()) {
+            const auto requester_uid = pending_policy_requests_.begin()->first.second;
+            auto request = std::move(pending_policy_requests_.begin()->second);
+            pending_policy_requests_.erase(pending_policy_requests_.begin());
+            complete_cancel(std::move(request), requester_uid);
+        }
+    }
+
+    void alf_streamer_session::complete_cancel(std::unique_ptr<service::ipc_context> request, std::uint64_t requester_uid) {
+        auto *kern = request->sys->get_kernel_system();
+        auto *thread = request->msg->own_thr;
+        // IPC retains the thread while pending. Still verify its subscription
+        // identity after the alive check, before touching the guest status; an
+        // address alone must never authorize completing a reused thread.
+        if (!kern->is_wiping() && kern->is_thread_alive(thread)
+            && thread->unique_id() == requester_uid
+            && thread->get_exit_type() == kernel::entity_exit_type::pending
+            && request->msg->request_sts.get(thread->owning_process()))
+            request->complete(epoc::error_cancel);
+    }
+
+    void alf_streamer_session::cancel_policy(std::uint32_t plugin, std::uint64_t thread) {
+        auto found = pending_policy_requests_.find({plugin, thread});
+        if (found == pending_policy_requests_.end())
+            return;
+        auto request = std::move(found->second);
+        pending_policy_requests_.erase(found);
+        complete_cancel(std::move(request), thread);
+    }
+
+    void alf_streamer_session::cancel_plugin(std::uint32_t plugin) {
+        auto entry = pending_policy_requests_.lower_bound({plugin, 0});
+        while (entry != pending_policy_requests_.end() && entry->first.first == plugin) {
+            const auto requester_uid = entry->first.second;
+            auto request = std::move(entry->second);
+            entry = pending_policy_requests_.erase(entry);
+            complete_cancel(std::move(request), requester_uid);
+        }
+    }
+
     void alf_streamer_session::fetch(service::ipc_context *ctx) {
         int function = ctx->msg->function;
         if ((function >= 20000) && (function <= 20005)) {
             function -= 20000;
         }
 
+        const auto plugin = ctx->get_argument_value<std::uint32_t>(0);
         switch (function) {
+        case 0: // LoadTfxPlugin: effects remain disabled, as before.
+            ctx->complete(plugin ? epoc::error_none : epoc::error_argument);
+            break;
+        case 1: // UnloadTfxPlugin also releases this session's pending requests.
+            if (!plugin) {
+                ctx->complete(epoc::error_argument);
+                break;
+            }
+            cancel_plugin(*plugin);
+            ctx->complete(epoc::error_none);
+            break;
         case 2: {
-            // Synchronous effect-plugin calls return a serialized TInt error
-            // in argument 2. Effects are intentionally disabled, so success
-            // is sufficient for all no-op transition commands.
+            const auto input = ctx->get_argument_value<std::string>(1);
+            if (!plugin || !input || input->size() < 4) {
+                ctx->complete(epoc::error_argument);
+                break;
+            }
+            if (ctx->get_argument_max_data_size(2) < sizeof(std::int32_t)) {
+                ctx->complete(epoc::error_bad_descriptor);
+                break;
+            }
+            const auto operation = read_little_endian(input->data(), 4);
+            if (operation == control_policy_cancel) {
+                if (input->size() != 12) {
+                    ctx->complete(epoc::error_argument);
+                    break;
+                }
+                const auto thread = read_little_endian(input->data() + 4, 8);
+                if (thread != ctx->msg->own_thr->unique_id()) {
+                    ctx->complete(epoc::error_permission_denied);
+                    break;
+                }
+                // Complete the original async status before the synchronous
+                // reply. CAlfTransitionRequest::DoCancel is intentionally empty.
+                cancel_policy(*plugin, thread);
+            } else if (operation > control_policy_get || operation == control_policy_request) {
+                ctx->complete(epoc::error_not_supported);
+                break;
+            }
+            // Preserve the existing disabled-effects response only for known
+            // synchronous commands; unknown commands are never fake success.
             const std::int32_t result = epoc::error_none;
-            ctx->write_data_to_descriptor_argument(2, result);
-            ctx->complete(epoc::error_none);
+            ctx->complete(ctx->write_data_to_descriptor_argument(2, result)
+                ? epoc::error_none : epoc::error_bad_descriptor);
             break;
         }
-        case 3:
-            // This is a long-lived transition-policy notification. The client
-            // fetches policy data only after the request is completed.
-            if (pending_plugin_request_) {
-                pending_plugin_request_->complete(epoc::error_cancel);
+        case 3: {
+            const auto input = ctx->get_argument_value<std::string>(1);
+            if (!plugin || !input || input->size() != 4) {
+                ctx->complete(epoc::error_argument);
+                break;
             }
-            pending_plugin_request_ = ctx->move_to_new();
+            if (read_little_endian(input->data(), 4) != control_policy_request) {
+                ctx->complete(epoc::error_not_supported);
+                break;
+            }
+            const request_key key{*plugin, ctx->msg->own_thr->unique_id()};
+            if (pending_policy_requests_.count(key)) {
+                ctx->complete(epoc::error_in_use);
+                break;
+            }
+            pending_policy_requests_.emplace(key, ctx->move_to_new());
             break;
+        }
         case 4:
-            if (pending_plugin_request_) {
-                pending_plugin_request_->complete(epoc::error_cancel);
-                pending_plugin_request_.reset();
-            }
+            // CancelAsynchronousData carries a plugin message ID, not a TOp.
+            // The official GfxEffects plugin does not implement CancelMessage;
+            // policy cancellation is exclusively the synchronous inner op 35.
+            ctx->complete(epoc::error_not_supported);
+            break;
+        case 5: // Frame-preparation hint: rendering effects remain disabled.
             ctx->complete(epoc::error_none);
             break;
         default:
-            ctx->complete(epoc::error_none);
+            ctx->complete(epoc::error_not_supported);
             break;
         }
     }
