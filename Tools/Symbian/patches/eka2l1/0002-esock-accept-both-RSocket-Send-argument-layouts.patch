From f8429ce58435e510cb771c4baff82d2d9e736bfe Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 29 Oct 2026 02:02:23 +0000
Subject: [PATCH 2/4] esock: accept both RSocket::Send argument layouts

Newer ESock clients send TIpcArgs(flags, &length, &data); older ones put
the length package, holding the flags, in the first slot. Send only knew
the older layout, so on Symbian^3 every send with a length return failed
with KErrArgument (curl: "Send failure: Invalid argument"). Pick the
layout from the argument types, as recv already does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FXGLpgfLR1SAt4ttxAHx1u
---
 src/emu/services/src/socket/socket.cpp | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/src/emu/services/src/socket/socket.cpp b/src/emu/services/src/socket/socket.cpp
index 714e6a1ea..08cb17fcd 100644
--- a/src/emu/services/src/socket/socket.cpp
+++ b/src/emu/services/src/socket/socket.cpp
@@ -307,13 +307,23 @@ namespace eka2l1::epoc::socket {
         
         std::uint32_t *size_return = nullptr;
         if (has_return_length) {
-            size_return = reinterpret_cast<std::uint32_t*>(ctx->get_descriptor_argument_ptr(0));
+            // Newer ESock passes TIpcArgs(flags, &length, &data); older ones put
+            // the length package (holding the flags) in the first slot.
+            const bool flags_first = !((int)ctx->msg->args.get_arg_type(0) & (int)ipc_arg_type::flag_des)
+                && ((int)ctx->msg->args.get_arg_type(1) & (int)ipc_arg_type::flag_des);
+            if (flags_first) {
+                flags = ctx->get_argument_value<std::uint32_t>(0);
+                size_return = reinterpret_cast<std::uint32_t*>(ctx->get_descriptor_argument_ptr(1));
+            } else {
+                size_return = reinterpret_cast<std::uint32_t*>(ctx->get_descriptor_argument_ptr(0));
+                if (size_return) {
+                    flags = *size_return;
+                }
+            }
             if (!size_return) {
                 ctx->complete(epoc::error_argument);
                 return;
             }
-
-            flags = *size_return;
         } else {
             flags = ctx->get_argument_value<std::uint32_t>(0);
         }
