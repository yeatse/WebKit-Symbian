+    void connmonitor_client_session::enqueue(const event_info &event) {
+        // Like the real ConnMon event queue, keep bounded recent history while
+        // the client is handling a previous event. State queries remain current.
+        if (events_.size() == 256) {
+            events_.pop_front();
