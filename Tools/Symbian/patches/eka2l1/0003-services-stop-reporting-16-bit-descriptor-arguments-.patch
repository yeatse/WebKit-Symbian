From 410d626ecfebc112d80a2ae04dd661610350fbf4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 29 Oct 2026 02:02:23 +0000
Subject: [PATCH 3/4] services: stop reporting 16-bit descriptor arguments as
 handles

ipc_arg_type::handle and flag_16b are both 1, so masking the argument type
with handle matched every 16-bit descriptor, and get_argument_data_size
and get_argument_max_data_size returned 4 for all of them. RConnection::
GetDesSetting then failed with KErrOverflow for any value over two
characters, such as the IAP name. Compare the whole type instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FXGLpgfLR1SAt4ttxAHx1u
---
 src/emu/services/src/context.cpp | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/src/emu/services/src/context.cpp b/src/emu/services/src/context.cpp
index 7b8feff25..0f7396579 100644
--- a/src/emu/services/src/context.cpp
+++ b/src/emu/services/src/context.cpp
@@ -285,8 +285,9 @@ namespace eka2l1 {
             const bool is_eka1 = sys->get_kernel_system()->is_eka1();
 
             if (!is_eka1) {
-                if ((static_cast<int>(arg_type) & static_cast<int>(ipc_arg_type::unspecified))
-                    || (static_cast<int>(arg_type) & static_cast<int>(ipc_arg_type::handle))) {
+                // handle shares its bit with flag_16b, so compare the whole type:
+                // masking with it made every 16-bit descriptor look like a handle.
+                if (arg_type == ipc_arg_type::handle) {
                     return 4;
                 }
             }
@@ -315,8 +316,9 @@ namespace eka2l1 {
             const bool is_eka1 = sys->get_kernel_system()->is_eka1();
 
             if (!is_eka1) {
-                if ((static_cast<int>(arg_type) & static_cast<int>(ipc_arg_type::unspecified))
-                    || (static_cast<int>(arg_type) & static_cast<int>(ipc_arg_type::handle))) {
+                // handle shares its bit with flag_16b, so compare the whole type:
+                // masking with it made every 16-bit descriptor look like a handle.
+                if (arg_type == ipc_arg_type::handle) {
                     return 4;
                 }
             }
