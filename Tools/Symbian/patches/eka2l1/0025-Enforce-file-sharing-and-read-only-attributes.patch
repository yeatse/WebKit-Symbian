Subject: [PATCH] Enforce file sharing and persistent read-only attributes

Apply after patch 0024. Independently opened file objects own sharing claims;
duplicate handles and mappings retain the original object. Check read-only and
compatibility before opening/truncation, and publish only successful opens.
Persist read-only attributes in the host file, defer RFile SetAtt until flush,
and reject unsupported attribute/time updates. Clear file sessions while their
sharing state is alive, and roll back unpublished handles on output errors.
Rename an exclusively open file without reopening/truncating it; retain the
handle, cursor and attributes. Respect the distinct RFs Rename/Replace rules.

diff --git a/src/emu/services/include/services/fs/file_attributes.h b/src/emu/services/include/services/fs/file_attributes.h
new file mode 100644
--- /dev/null
+++ b/src/emu/services/include/services/fs/file_attributes.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <cstdint>
+
+namespace eka2l1 {
+    enum class read_only_change { invalid, unsupported, unchanged, set, clear };
+
+    inline read_only_change requested_read_only_change(std::uint32_t set, std::uint32_t clear) {
+        // f32file.h: Dir, Volume and Remote cannot be changed through SetAtt.
+        constexpr std::uint32_t ignored = 0x10 | 0x08 | 0x100;
+        constexpr std::uint32_t read_only = 0x01;
+        if (set & clear)
+            return read_only_change::invalid;
+        if ((set | clear) & ~(ignored | read_only))
+            return read_only_change::unsupported;
+        if (set & read_only)
+            return read_only_change::set;
+        if (clear & read_only)
+            return read_only_change::clear;
+        return read_only_change::unchanged;
+    }
+}
diff --git a/src/emu/services/include/services/fs/file_share.h b/src/emu/services/include/services/fs/file_share.h
new file mode 100644
--- /dev/null
+++ b/src/emu/services/include/services/fs/file_share.h
@@ -0,0 +1,53 @@
+// RFile sharing compatibility follows the public f32file.h promotion table.
+// Claims belong to independently opened file objects, not to processes.
+#pragma once
+
+#include <array>
+#include <cassert>
+#include <cstdint>
+#include <limits>
+
+namespace eka2l1 {
+    class file_share_state {
+        // Exclusive, ReadersOnly, Any, optional reader, optional writer.
+        std::array<std::uint32_t, 5> counts_{};
+
+        static unsigned index(unsigned mode, bool write) {
+            return mode == 3 ? (write ? 4 : 3) : mode;
+        }
+
+    public:
+        std::uint32_t use_count{0};
+
+        bool compatible(unsigned mode, bool write) const {
+            if (mode > 3 || (mode == 1 && write))
+                return false;
+            if (!use_count)
+                return true;
+            if (!mode || counts_[0])
+                return false;
+            if (mode == 1)
+                return !counts_[2] && !counts_[4];
+            if (mode == 2 || write)
+                return !counts_[1];
+            return true;
+        }
+
+        bool can_acquire(unsigned mode, bool write) const {
+            return compatible(mode, write)
+                && use_count != std::numeric_limits<std::uint32_t>::max();
+        }
+
+        void acquire(unsigned mode, bool write) {
+            assert(can_acquire(mode, write));
+            ++counts_[index(mode, write)];
+            ++use_count;
+        }
+
+        void release(unsigned mode, bool write) {
+            assert(mode <= 3 && counts_[index(mode, write)] && use_count);
+            --counts_[index(mode, write)];
+            --use_count;
+        }
+    };
+}
