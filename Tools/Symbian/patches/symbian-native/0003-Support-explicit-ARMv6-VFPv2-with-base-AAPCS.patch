+TEST(ArmAttributesTest, ConvertsExplicitArmv6Vfpv2WithBasePcsAndImageFlag) {
+  auto attributes = Attributes(6);
+  attributes[21] = 2;  // AEABI Tag_FP_arch: VFPv2, not VFP arguments.
+  const auto elf = WithAttributes(testing::Executable(), attributes);
+  const auto header = InspectElf32(elf);
+  ASSERT_TRUE(header.ok()) << header.status();
+  EXPECT_EQ(header->arm.fp_arch, 2);
+  EXPECT_EQ(header->arm.vfp_args, 0);
+  const auto image = e32::ConvertPicExecutable(elf, 0xe0000808);
+  ASSERT_TRUE(image.ok()) << image.status();
+  EXPECT_EQ(internal::Read32(*image, 44), 0x12100028);
+  EXPECT_EQ(image->substr(internal::Read32(*image, 100)),
+            testing::Executable().substr(84, 32));
+  const auto info = e32::InspectImage(*image);
+  ASSERT_TRUE(info.ok()) << info.status();
+  EXPECT_EQ(info->flags, 0x12100028);
+  EXPECT_EQ(info->architecture, "armv6");
+  EXPECT_FALSE(e32::ConvertEka1Executable(elf, 0xe0000808).ok());
+}
+
+TEST(ArmAttributesTest, RejectsVfpWithoutExplicitArmv6AndNonBasePcs) {
+  for (const auto& [offset, value] :
+       std::vector<std::pair<size_t, uint8_t>>{
+           {17, 0}, {17, 3}, {17, 10}, {19, 2}, {21, 1},
+           {21, 3}, {21, 4}, {21, 5}, {23, 1}, {23, 2}, {23, 3}}) {
+    auto attributes = Attributes(6);
+    attributes[21] = 2;
+    attributes[offset] = static_cast<char>(value);
+    const auto image = e32::ConvertPicExecutable(
+        WithAttributes(testing::Executable(), attributes), 0xe0000808);
+    EXPECT_EQ(image.status().code(), absl::StatusCode::kUnimplemented)
+        << offset << ": " << static_cast<unsigned>(value);
+  }
+  auto attributes = Attributes(6);
+  attributes[21] = 2;
+  for (uint32_t flags : {0x05000400U, 0x05000600U}) {
+    auto elf = WithAttributes(testing::Executable(), attributes);
+    // EF_ARM_ABI_FLOAT_HARD, including contradictory hard/soft flags.
+    Put32(elf, 36, flags);
+    EXPECT_EQ(e32::ConvertPicExecutable(elf, 0xe0000808).status().code(),
+              absl::StatusCode::kUnimplemented);
+  }
+  attributes.append("\x0c\x01", 2);  // Tag_Advanced_SIMD_arch: NEONv1.
+  Put32(attributes, 1, static_cast<uint32_t>(attributes.size() - 1));
+  Put32(attributes, 12, static_cast<uint32_t>(attributes.size() - 11));
+  EXPECT_EQ(e32::ConvertPicExecutable(
+                WithAttributes(testing::Executable(), attributes), 0xe0000808)
+                .status()
+                .code(),
+            absl::StatusCode::kUnimplemented);
+}
+
+TEST(ArmAttributesTest, RejectsUnsupportedE32FloatingPointProfiles) {
+  auto attributes = Attributes(6);
+  attributes[21] = 2;
+  const auto image = e32::ConvertPicExecutable(
+      WithAttributes(testing::Executable(), attributes), 0xe0000808);
+  ASSERT_TRUE(image.ok()) << image.status();
+  for (uint32_t float_flags : {0x00200000U, 0x00300000U, 0x00f00000U}) {
+    auto unsupported = *image;
+    Put32(unsupported, 44, 0x12000028 | float_flags);
+    EXPECT_EQ(e32::InspectImage(unsupported).status().code(),
+              absl::StatusCode::kUnimplemented);
+  }
+  auto mismatched = *image;
+  Put16(mismatched, 122, 0x2001);  // VFPv2 profile requires ARMv6 identity.
+  EXPECT_EQ(e32::InspectImage(mismatched).status().code(),
+            absl::StatusCode::kUnimplemented);
+}
