+// A sorted EHABI table exceeding 64 KiB, with CANTUNWIND function records
+// and all four absolute pointers retained in the Symbian descriptor.
+inline std::string LargeExceptionExecutable() {
+  constexpr uint32_t kCount = 8193;
+  constexpr uint32_t kCodeOffset = 84;
+  constexpr uint32_t kBase = 0x8000;
+  constexpr uint32_t kTextSize = 16 + kCount * 4;
+  constexpr uint32_t kIndexSize = kCount * 8;
+  constexpr uint32_t kDescriptor = kTextSize + kIndexSize;
+  constexpr uint32_t kCodeSize = kDescriptor + 16;
+  constexpr uint32_t kSections = kCodeOffset + kCodeSize;
+  constexpr uint32_t kSymbols = kSections + 7 * 40;
+  constexpr uint32_t kRelocations = kSymbols + 6 * 16;
+  constexpr uint32_t kStrings = kRelocations + 4 * 8;
+  std::string bytes(kStrings, '\0');
+  const auto original = Executable();
+  bytes.replace(0, 84, original.substr(0, 84));
+  bytes.replace(kCodeOffset, 16, original.substr(84, 16));
+  Put32(bytes, 32, kSections);
+  Put16(bytes, 48, 7);
+  Put16(bytes, 50, 6);
+  Put32(bytes, 68, kCodeSize);
+  Put32(bytes, 72, kCodeSize);
+  std::string strings(1, '\0');
+  auto name = [&](std::string_view value) {
+    const auto offset = static_cast<uint32_t>(strings.size());
+    strings.append(value);
+    strings.push_back('\0');
+    return offset;
+  };
+  auto section = [&](uint32_t index, std::string_view label, uint32_t type,
+                     uint32_t flags, uint32_t address, uint32_t offset,
+                     uint32_t size, uint32_t link, uint32_t info,
+                     uint32_t entry) {
+    const uint32_t p = kSections + index * 40;
+    Put32(bytes, p, name(label));
+    Put32(bytes, p + 4, type);
+    Put32(bytes, p + 8, flags);
+    Put32(bytes, p + 12, address);
+    Put32(bytes, p + 16, offset);
+    Put32(bytes, p + 20, size);
+    Put32(bytes, p + 24, link);
+    Put32(bytes, p + 28, info);
+    Put32(bytes, p + 32, 4);
+    Put32(bytes, p + 36, entry);
+  };
+  section(1, ".text", 1, 6, kBase, kCodeOffset, kTextSize, 0, 0, 0);
+  section(2, ".ARM.exidx", 0x70000001, 0x82, kBase + kTextSize,
+          kCodeOffset + kTextSize, kIndexSize, 1, 0, 8);
+  section(3, ".rodata", 1, 2, kBase + kDescriptor,
+          kCodeOffset + kDescriptor, 16, 0, 0, 0);
+  section(4, ".symtab", 2, 0, 0, kSymbols, 6 * 16, 6, 1, 16);
+  section(5, ".rel.rodata", 9, 0, 0, kRelocations, 4 * 8, 4, 3, 8);
+  section(6, ".strtab", 3, 0, 0, kStrings, 0, 0, 0, 0);
+  auto symbol = [&](uint32_t index, std::string_view label, uint32_t address,
+                    uint32_t size, uint16_t owner, uint8_t type) {
+    const uint32_t p = kSymbols + index * 16;
+    Put32(bytes, p, name(label));
+    Put32(bytes, p + 4, address);
+    Put32(bytes, p + 8, size);
+    bytes[p + 12] = static_cast<char>(0x10 | type);
+    Put16(bytes, p + 14, owner);
+  };
+  symbol(1, "Symbian$$CPP$$Exception$$Descriptor", kBase + kDescriptor,
+         16, 3, 1);
+  symbol(2, "__exidx_start", kBase + kTextSize, 0, 2, 0);
+  symbol(3, "__exidx_end", kBase + kDescriptor, 0, 2, 0);
+  symbol(4, "__ro_base", kBase, 0, 1, 0);
+  symbol(5, "__ro_end", kBase + kCodeSize, 0, 3, 0);
+  for (uint32_t i = 0; i < kCount; ++i) {
+    const uint32_t p = kCodeOffset + kTextSize + i * 8;
+    const uint32_t function = kBase + 16 + i * 4;
+    Put32(bytes, p, (function - (kBase + kTextSize + i * 8)) & 0x7fffffff);
+    Put32(bytes, p + 4, 1);  // EXIDX_CANTUNWIND.
+  }
+  for (uint32_t i = 0; i < 4; ++i) {
+    Put32(bytes, kCodeOffset + kDescriptor + i * 4,
+          analysis::internal::Read32(bytes, kSymbols + (i + 2) * 16 + 4));
+    Put32(bytes, kRelocations + i * 8, kBase + kDescriptor + i * 4);
+    Put32(bytes, kRelocations + i * 8 + 4, ((i + 2) << 8) | 2);
+  }
+  Put32(bytes, kSections + 6 * 40 + 20,
+        static_cast<uint32_t>(strings.size()));
+  bytes.append(strings);
+  return bytes;
+}
+
 }  // namespace symbian::testing
 
 #endif  // SYMBIAN_TESTS_E32_FIXTURE_H_
