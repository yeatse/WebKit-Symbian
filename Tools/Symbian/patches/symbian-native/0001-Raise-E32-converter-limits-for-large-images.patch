+TEST(E32Test, PreservesExceptionIndexBeyond64KiB) {
+  const auto elf = testing::LargeExceptionExecutable();
+  const uint32_t sections = Read32(elf, 32);
+  const uint32_t index_size = Read32(elf, sections + 2 * 40 + 20);
+  ASSERT_GT(index_size, 65536);
+  const auto image = ConvertPicExecutable(elf, 0xe0000808);
+  ASSERT_TRUE(image.ok()) << image.status();
+  const auto info = InspectImage(*image);
+  ASSERT_TRUE(info.ok()) << info.status();
+  const uint32_t code_size = Read32(elf, 68);
+  const uint32_t descriptor = code_size - 16;
+  EXPECT_EQ(info->exception_descriptor_offset, descriptor);
+  EXPECT_EQ(info->code_relocations,
+            (std::vector<uint32_t>{descriptor, descriptor + 4,
+                                   descriptor + 8, descriptor + 12}));
+  EXPECT_EQ(image->substr(Read32(*image, 100), code_size),
+            elf.substr(Read32(elf, 56), code_size));
+}
+
+TEST(E32Test, RejectsMalformedLargeExceptionIndex) {
+  const auto original = testing::LargeExceptionExecutable();
+  const uint32_t section = Read32(original, 32) + 2 * 40;
+  for (const auto& [offset, value] :
+       std::vector<std::pair<uint32_t, uint32_t>>{
+           {section + 20, Read32(original, section + 20) - 4},
+           {section + 20, Read32(original, 68) + 8},
+           {section + 12, Read32(original, section + 12) + 2}}) {
+    auto elf = original;
+    Put32(elf, offset, value);
+    const auto image = ConvertPicExecutable(elf, 0xe0000808);
+    EXPECT_EQ(image.status().code(), absl::StatusCode::kDataLoss) << offset;
+  }
+}
+
+TEST(E32Test, RejectsLargeExceptionDescriptorBoundsMismatch) {
+  const auto original = testing::LargeExceptionExecutable();
+  const uint32_t descriptor = Read32(original, 56) + Read32(original, 68) - 16;
+  for (uint32_t i = 0; i < 4; ++i) {
+    auto elf = original;
+    const uint32_t offset = descriptor + i * 4;
+    Put32(elf, offset, Read32(elf, offset) + 4);
+    const auto image = ConvertPicExecutable(elf, 0xe0000808);
+    EXPECT_EQ(image.status().code(), absl::StatusCode::kDataLoss) << i;
+    EXPECT_EQ(image.status().message(),
+              i == 3 ? "Resolved ELF absolute pointer/state outside its mapping"
+                     : "Exception descriptor bounds mismatch");
+  }
+}
+
 TEST(E32Test, PreservesIndependentDataBssAndTypedPointers) {
   const auto image =
       ConvertPicExecutable(testing::DataExecutable(), 0xe0000808);
