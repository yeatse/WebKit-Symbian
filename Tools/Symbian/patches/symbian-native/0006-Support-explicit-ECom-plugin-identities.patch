+    return absl::InvalidArgumentError("Unsupported E32 DLL UID2");
+  }
+  if (!ValidUid3(uid3, definition != nullptr && dll_uid2 == kEcomPluginUid2)) {
+    return absl::InvalidArgumentError("Invalid UID3 for selected E32 profile");
   }
   if ((capabilities & ~kSupportedCapabilities) != 0) {
