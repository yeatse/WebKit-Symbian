diff --git a/cpp/symbian/e32/e32.h b/cpp/symbian/e32/e32.h
--- a/cpp/symbian/e32/e32.h
+++ b/cpp/symbian/e32/e32.h
@@ -107,6 +107,16 @@
                                        uint32_t uid3,
                                        uint32_t capabilities = 0);
 
+// Explicit ECom plugin identity, for original native plugins such as FEP.
+// UID2 must be the ordinary DLL UID 0x1000008d or ECom UID 0x10009d8d.
+// Only the ECom profile accepts assigned nonzero UID3 values outside the
+// experimental range. This is format support, not a capability grant.
+// The original ConvertDll API and its output profile are unchanged.
+absl::StatusOr<std::string> ConvertDllWithUid2(
+    std::string_view elf, std::string_view definition,
+    const std::vector<std::string>& proxies, uint32_t uid3, uint32_t uid2,
+    uint32_t capabilities = 0);
+
 // Checks bounds, UID checksum, header CRC and this supported profile only.
 // Other E32 profiles return Unimplemented, not a general validity verdict.
 absl::StatusOr<ImageInfo> InspectImage(std::string_view bytes);
