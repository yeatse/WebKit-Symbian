 using analysis::internal::Within;
 
 constexpr uint32_t kHeaderSize = 156;
+constexpr uint32_t kOrdinaryDllUid2 = 0x1000008d;
+constexpr uint32_t kEcomPluginUid2 = 0x10009d8d;
+
+bool ValidUid3(uint32_t uid3, bool plugin) {
+  // Registered ECom plugins use their assigned UID3. The experimental process
+  // and ordinary DLL profiles retain the SDK's unprotected range restriction.
+  return plugin ? uid3 != 0 && uid3 != UINT32_MAX
+                : uid3 >= 0xe0000000 && uid3 <= 0xefffffff;
+}
 constexpr uint32_t kFlags = 0x12000028;  // V header, ELF imports, EABI, EKA2.
 // f32image.h KImageHWFloatMask/Shift and e32const.h EFpTypeVFPv2 (1).
 // These describe instructions used, independently of the procedure-call ABI.
@@ -809,12 +818,17 @@
