diff --git a/cpp/tests/e32_plugin_identity_test.cc b/cpp/tests/e32_plugin_identity_test.cc
new file mode 100644
--- /dev/null
+++ b/cpp/tests/e32_plugin_identity_test.cc
@@ -0,0 +1,131 @@
+#include <cstdint>
+#include <string>
+
+#include <gtest/gtest.h>
+
+#include "e32_fixture.h"
+#include "symbian/analysis/bytes.h"
+#include "symbian/analysis/checksum.h"
+#include "symbian/e32/e32.h"
+
+namespace symbian::e32 {
+namespace {
+using analysis::internal::Put32;
+using analysis::internal::Read32;
+
+std::string ExportedExecutable() {
+  std::string elf = testing::Executable();
+  Put32(elf, 292, static_cast<uint32_t>(elf.size()));
+  Put32(elf, 296, 10);
+  elf.append("\0Function\0", 10);
+  Put32(elf, 332, 1);
+  Put32(elf, 340, 4);
+  elf[344] = 0x12;
+  return elf;
+}
+
+// Recompute both checksums after an identity mutation so rejection checks the
+// selected profile rather than merely detecting the test's stale checksum.
+std::string WithIdentity(std::string image, uint32_t uid2, uint32_t uid3) {
+  Put32(image, 4, uid2);
+  Put32(image, 8, uid3);
+  Put32(image, 128, uid3);
+  Put32(image, 12, analysis::internal::UidChecksum(image));
+  Put32(image, 20, 0xc90fdaa2);
+  uint32_t crc = 0;
+  for (uint32_t i = 0; i < Read32(image, 100); ++i) {
+    crc ^= static_cast<uint8_t>(image[i]);
+    for (unsigned bit = 0; bit < 8; ++bit) {
+      crc = (crc >> 1) ^ ((crc & 1) ? 0xedb88320U : 0U);
+    }
+  }
+  Put32(image, 20, crc);
+  return image;
+}
+
+constexpr char kDefinition[] = "EXPORTS\nFunction @ 1 NONAME\n";
+constexpr uint32_t kPluginUid2 = 0x10009d8d;
+constexpr uint32_t kFepUid3 = 0x100056de;
+
+TEST(E32PluginIdentityTest, ConvertsAssignedFepIdentityWithNativeValidation) {
+  const auto image = ConvertDllWithUid2(ExportedExecutable(), kDefinition, {},
+                                        kFepUid3, kPluginUid2);
+  ASSERT_TRUE(image.ok()) << image.status();
+  EXPECT_EQ(Read32(*image, 4), kPluginUid2);
+  EXPECT_EQ(Read32(*image, 8), kFepUid3);
+  EXPECT_EQ(Read32(*image, 136), 0U);
+  const auto info = InspectImage(*image);
+  ASSERT_TRUE(info.ok()) << info.status();
+  EXPECT_TRUE(info->dll);
+  EXPECT_EQ(info->uid3, kFepUid3);
+  EXPECT_EQ(info->secure_id, kFepUid3);
+  ASSERT_EQ(info->exports.size(), 1U);
+  EXPECT_EQ(info->exports[0].ordinal, 1U);
+  EXPECT_FALSE(info->exports[0].absent);
+}
+
+TEST(E32PluginIdentityTest, PreservesDefaultDllBytesAndApi) {
+  const auto original =
+      ConvertDll(ExportedExecutable(), kDefinition, {}, 0xee000003);
+  const auto explicit_default = ConvertDllWithUid2(
+      ExportedExecutable(), kDefinition, {}, 0xee000003, 0x1000008d);
+  ASSERT_TRUE(original.ok()) << original.status();
+  ASSERT_TRUE(explicit_default.ok()) << explicit_default.status();
+  EXPECT_EQ(*original, *explicit_default);
+  EXPECT_EQ(Read32(*original, 4), 0x1000008dU);
+}
+
+TEST(E32PluginIdentityTest, LeavesOrdinaryDllAndProcessUidRulesIntact) {
+  EXPECT_FALSE(
+      ConvertDll(ExportedExecutable(), kDefinition, {}, kFepUid3).ok());
+  EXPECT_FALSE(ConvertPicExecutable(testing::Executable(), kFepUid3).ok());
+  const auto exe = ConvertPicExecutable(testing::Executable(), 0xe0000808);
+  ASSERT_TRUE(exe.ok()) << exe.status();
+  EXPECT_EQ(Read32(*exe, 4), 0U);
+  EXPECT_TRUE(InspectImage(*exe).ok());
+}
+
+TEST(E32PluginIdentityTest, RejectsUnknownDllClassAndSentinelPluginUid) {
+  for (uint32_t uid2 : {0U, 1U, 0x1000007aU, 0x10000079U, 0xffffffffU}) {
+    EXPECT_FALSE(ConvertDllWithUid2(ExportedExecutable(), kDefinition, {},
+                                    kFepUid3, uid2)
+                     .ok());
+  }
+  for (uint32_t uid3 : {0U, 0xffffffffU}) {
+    EXPECT_FALSE(ConvertDllWithUid2(ExportedExecutable(), kDefinition, {}, uid3,
+                                    kPluginUid2)
+                     .ok());
+  }
+}
+
+TEST(E32PluginIdentityTest, NativeInspectorEnforcesIdentityWithCoherentCrc) {
+  const auto image = ConvertDllWithUid2(ExportedExecutable(), kDefinition, {},
+                                        kFepUid3, kPluginUid2);
+  ASSERT_TRUE(image.ok()) << image.status();
+  EXPECT_TRUE(InspectImage(WithIdentity(*image, kPluginUid2, kFepUid3)).ok());
+  EXPECT_FALSE(InspectImage(WithIdentity(*image, 0, kFepUid3)).ok());
+  EXPECT_FALSE(InspectImage(WithIdentity(*image, 0x1000008d, kFepUid3)).ok());
+  EXPECT_FALSE(InspectImage(WithIdentity(*image, kPluginUid2, 0)).ok());
+  EXPECT_FALSE(
+      InspectImage(WithIdentity(*image, kPluginUid2, 0xffffffff)).ok());
+  auto corrupt = *image;
+  corrupt[12] ^= 1;
+  EXPECT_FALSE(InspectImage(corrupt).ok());
+  corrupt = *image;
+  corrupt[20] ^= 1;
+  EXPECT_FALSE(InspectImage(corrupt).ok());
+}
+
+TEST(E32PluginIdentityTest, DoesNotGrantUnsupportedCapabilities) {
+  EXPECT_FALSE(ConvertDllWithUid2(ExportedExecutable(), kDefinition, {},
+                                  kFepUid3, kPluginUid2, 1)
+                   .ok());
+  const auto image = ConvertDllWithUid2(ExportedExecutable(), kDefinition, {},
+                                        kFepUid3, kPluginUid2, 1U << 13);
+  ASSERT_TRUE(image.ok()) << image.status();
+  const auto info = InspectImage(*image);
+  ASSERT_TRUE(info.ok()) << info.status();
+  EXPECT_EQ(info->capabilities, 1U << 13);
+}
+}  // namespace
+}  // namespace symbian::e32
