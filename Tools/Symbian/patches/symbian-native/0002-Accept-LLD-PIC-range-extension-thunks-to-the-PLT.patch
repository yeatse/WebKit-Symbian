+TEST(E32Test, AcceptsSingleBranchImportThunkInEitherDirection) {
+  for (uint32_t thunk : {32U, 124U}) {
+    std::string elf(128, '\0');
+    const internal::Segment code{0, 0x8000, 128};
+    Put32(elf, 0, 0xeb000000 | ((thunk - 8) / 4));
+    const int32_t displacement = 64 - static_cast<int32_t>(thunk) - 8;
+    Put32(elf, thunk,
+          0xea000000 | (static_cast<uint32_t>(displacement / 4) & 0xffffff));
+    Put32(elf, 64, 0xe28fc000);
+    Put32(elf, 68, 0xe28cc000);
+    Put32(elf, 72, 0xe5bcf018);  // Slot at code + 96.
+    EXPECT_TRUE(internal::CheckImportCall(elf, code, 0x8000, 28, 96).ok());
+    EXPECT_FALSE(internal::CheckImportCall(elf, code, 0x8000, 28, 100).ok());
+  }
+}
+
+TEST(E32Test, RejectsUnverifiedSingleBranchImportThunks) {
+  for (uint32_t branch : {0x0a000006U, 0xeb000006U, 0xea7fffffU,
+                          0xea800000U, 0xeafffffeU, 0xea000015U}) {
+    std::string elf(128, '\0');
+    const internal::Segment code{0, 0x8000, 128};
+    Put32(elf, 0, 0xeb000006);
+    Put32(elf, 32, branch);
+    Put32(elf, 64, 0xe28fc000);
+    Put32(elf, 68, 0xe28cc000);
+    Put32(elf, 72, 0xe5bcf018);
+    EXPECT_FALSE(internal::CheckImportCall(elf, code, 0x8000, 28, 96).ok())
+        << std::hex << branch;
+  }
+}
+
+TEST(E32Test, AcceptsArmAndThumbPicImportThunks) {
+  for (bool thumb : {false, true}) {
+    std::string elf(128, '\0');
+    const internal::Segment code{0, 0x8000, 128};
+    if (thumb) {
+      Put16(elf, 0, 0xf000);
+      Put16(elf, 2, 0xf80c);  // Thumb BL to code + 28.
+      Put16(elf, 28, 0x4778);
+      Put16(elf, 30, 0x46c0);
+    } else {
+      Put32(elf, 0, 0xeb000006);
+    }
+    Put32(elf, 32, 0xe59fc004);
+    Put32(elf, 36, 0xe08fc00c);
+    Put32(elf, 40, 0xe12fff1c);
+    Put32(elf, 44, 64 - 44);
+    Put32(elf, 64, 0xe28fc000);
+    Put32(elf, 68, 0xe28cc000);
+    Put32(elf, 72, 0xe5bcf018);
+    EXPECT_TRUE(internal::CheckImportCall(elf, code, 0x8000,
+                                         thumb ? 10 : 28, 96).ok());
+    EXPECT_FALSE(internal::CheckImportCall(elf, code, 0x8000,
+                                          thumb ? 10 : 28, 100).ok());
+  }
+}
+
+TEST(E32Test, RejectsMalformedPicThunksAndTruncatedImportInstructions) {
+  std::string original(128, '\0');
+  const internal::Segment code{0, 0x8000, 128};
+  Put32(original, 0, 0xeb000006);
+  Put32(original, 32, 0xe59fc004);
+  Put32(original, 36, 0xe08fc00c);
+  Put32(original, 40, 0xe12fff1c);
+  Put32(original, 44, 20);
+  Put32(original, 64, 0xe28fc000);
+  Put32(original, 68, 0xe28cc000);
+  Put32(original, 72, 0xe5bcf018);
+  for (const auto& [offset, value] :
+       std::vector<std::pair<uint32_t, uint32_t>>{
+           {32, 0xe59fc000}, {36, 0xe08fc004}, {40, 0xe12fff10},
+           {44, 21}, {44, 128}, {44, 0xffff0000}, {72, 0xe5bcf01c}}) {
+    auto elf = original;
+    Put32(elf, offset, value);
+    EXPECT_FALSE(internal::CheckImportCall(elf, code, 0x8000, 28, 96).ok());
+  }
+  EXPECT_FALSE(internal::CheckImportCall(original, code, 0x7ffc, 28, 96).ok());
+  EXPECT_FALSE(internal::CheckImportCall(original, code, 0x807e, 10, 96).ok());
+  EXPECT_FALSE(internal::CheckImportCall(original.substr(0, 127), code,
+                                        0x8000, 28, 96).ok());
+  Put32(original, 0, 0xeb00001c);  // Truncated long thunk at code + 120.
+  Put32(original, 120, 0xe59fc004);
+  Put32(original, 124, 0xe08fc00c);
+  EXPECT_FALSE(internal::CheckImportCall(original, code, 0x8000, 28, 96).ok());
+}
