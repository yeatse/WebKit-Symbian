+"""Stage pinned original ScreenPlay headers and complete frozen DLL imports.
+
+These publishedPartner/prototype interfaces do not establish compatibility
+with an untested firmware. No system implementation or capability is supplied.
+"""
+
+import hashlib
+import json
+from pathlib import Path
+
+from symbian.sdk import build_import_proxy
+
+MANIFEST = "research/native-sdk/screenplay.json"
+
+
+def _records(workspace: Path) -> dict:
+    """Load the exact, separately reviewed ScreenPlay source contract."""
+    return json.loads((workspace / MANIFEST).read_text())
+
+
+def _copy(workspace: Path, output: Path, record: dict) -> None:
+    """Copy a pinned source without replacing a differing existing payload."""
+    source = workspace / "research/upstream" / record["source"]
+    data = source.read_bytes()
+    if hashlib.sha256(data).hexdigest() != record["sha256"]:
+        raise ValueError(f"ScreenPlay source digest mismatch: {source}")
+    destination = output / record["destination"]
+    if destination.is_symlink():
+        raise ValueError(f"ScreenPlay destination is a symlink: {destination}")
+    if destination.exists():
+        if not destination.is_file() or destination.read_bytes() != data:
+            raise ValueError(f"ScreenPlay payload differs: {destination}")
+        return
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    destination.write_bytes(data)
+
+
+def stage_screenplay_headers(workspace: Path, output: Path) -> None:
+    """Deliver the original include closure with its source provenance."""
+    manifest = _records(workspace)
+    for record in manifest["headers"]:
+        _copy(workspace, output, record)
+    destination = output / "share/symbian/screenplay/manifest.json"
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    data = (workspace / MANIFEST).read_bytes()
+    if destination.exists() and destination.read_bytes() != data:
+        raise ValueError("Existing ScreenPlay source manifest differs")
+    destination.write_bytes(data)
+
+
+def stage_screenplay_imports(
+    workspace: Path, output: Path, compiler: Path, linker: Path
+) -> None:
+    """Build complete frozen ordinal proxies, without firmware DLL bytes."""
+    for library in _records(workspace)["libraries"]:
+        _copy(workspace, output, library)
+        name = library["dll"].removesuffix(".dll")
+        build_import_proxy(
+            output / library["destination"],
+            [],
+            library["dll"],
+            output / "proxies" / name,
+            str(compiler),
+            str(linker),
+        )
