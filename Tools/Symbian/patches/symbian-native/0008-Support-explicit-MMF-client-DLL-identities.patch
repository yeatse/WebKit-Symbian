diff --git a/cpp/symbian/e32/e32.h b/cpp/symbian/e32/e32.h
--- a/cpp/symbian/e32/e32.h
+++ b/cpp/symbian/e32/e32.h
@@ -107,8 +107,8 @@
                                        uint32_t uid3,
                                        uint32_t capabilities = 0);
 
-// Explicit ECom plugin identity, for original native plugins such as FEP.
-// UID2 must be the ordinary DLL UID 0x1000008d or ECom UID 0x10009d8d.
+// Explicit original DLL identity: ordinary 0x1000008d, ECom 0x10009d8d,
+// or MMF client 0x10003b19 (as declared by original MMF patch MMP files).
 // Only the ECom profile accepts assigned nonzero UID3 values outside the
 // experimental range. This is format support, not a capability grant.
 // The original ConvertDll API and its output profile are unchanged.
diff --git a/cpp/tests/e32_plugin_identity_test.cc b/cpp/tests/e32_plugin_identity_test.cc
--- a/cpp/tests/e32_plugin_identity_test.cc
+++ b/cpp/tests/e32_plugin_identity_test.cc
@@ -127,5 +127,41 @@
   ASSERT_TRUE(info.ok()) << info.status();
   EXPECT_EQ(info->capabilities, 1U << 13);
 }
+TEST(E32MmfClientIdentityTest, PreservesDeclaredMmfClassAndNativeValidation) {
+  const auto image = ConvertDllWithUid2(ExportedExecutable(), kDefinition, {},
+                                        0xee000001, 0x10003b19);
+  ASSERT_TRUE(image.ok()) << image.status();
+  EXPECT_EQ(Read32(*image, 4), 0x10003b19U);
+  EXPECT_EQ(Read32(*image, 8), 0xee000001U);
+  EXPECT_EQ(Read32(*image, 136), 0U);
+  const auto info = InspectImage(*image);
+  ASSERT_TRUE(info.ok()) << info.status();
+  EXPECT_TRUE(info->dll);
+  EXPECT_EQ(info->uid3, 0xee000001U);
+  EXPECT_EQ(info->exports.size(), 1U);
+}
+
+TEST(E32MmfClientIdentityTest, DoesNotBroadenMmfUidOrProcessProfiles) {
+  for (uint32_t uid3 : {0U, 0xffffffffU, kFepUid3}) {
+    EXPECT_FALSE(ConvertDllWithUid2(ExportedExecutable(), kDefinition, {}, uid3,
+                                    0x10003b19).ok());
+  }
+  EXPECT_FALSE(ConvertPicExecutable(testing::Executable(), kFepUid3).ok());
+  const auto ordinary = ConvertDll(ExportedExecutable(), kDefinition, {},
+                                   0xee000001);
+  ASSERT_TRUE(ordinary.ok()) << ordinary.status();
+  EXPECT_EQ(Read32(*ordinary, 4), 0x1000008dU);
+}
+
+TEST(E32MmfClientIdentityTest, InspectorChecksMmfUidAndCapabilities) {
+  const auto image = ConvertDllWithUid2(ExportedExecutable(), kDefinition, {},
+                                        0xee000001, 0x10003b19);
+  ASSERT_TRUE(image.ok()) << image.status();
+  EXPECT_FALSE(InspectImage(WithIdentity(*image, 0, 0xee000001)).ok());
+  EXPECT_FALSE(InspectImage(WithIdentity(*image, 0x10003b19, kFepUid3)).ok());
+  EXPECT_FALSE(ConvertDllWithUid2(ExportedExecutable(), kDefinition, {},
+                                  0xee000001, 0x10003b19, 1).ok());
+}
