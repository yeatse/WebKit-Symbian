From 9547ef02558344b9ab124470a57f3ec159fa20ee Mon Sep 17 00:00:00 2001
From: luck <rommelalexander4481@outlook.com>
Date: Sun, 1 Nov 2026 02:17:20 +0000
Subject: [PATCH] Translate Ctrl/Alt editing keys and refresh repeated key
 codes

Track left/right and aggregate Ctrl and Alt alongside Shift. Modifier
transitions remain raw up/down events and do not become characters or
repeat timers. Translate the opt-in ASCII keyboard profile into letter
or Ctrl-letter codes while retaining the physical scan code.

Recompute repeated character codes with current modifiers without changing
the repeat timer identity used by key-up cancellation. Keep existing phone
and softkey mappings. Add regression coverage for modifiers, all ASCII
control letters, special scans and changing modifiers on held letters.

---
 .../include/services/window/keyboard.h        | 46 +++++++++---
 src/emu/services/src/window/window.cpp        |  4 +-
 src/tests/epoc/services/window/keyboard.cpp   | 72 +++++++++++++++++++
 3 files changed, 112 insertions(+), 10 deletions(-)

diff --git a/src/emu/services/include/services/window/keyboard.h b/src/emu/services/include/services/window/keyboard.h
index bb211ee..62d317f 100644
--- a/src/emu/services/include/services/window/keyboard.h
+++ b/src/emu/services/include/services/window/keyboard.h
@@ -22,33 +22,63 @@ namespace eka2l1::epoc {
         }
 
         static bool is_repeatable(std::uint32_t scan) {
-            return !is_shift(scan) && scan != std_key_device_0 && scan != std_key_device_1;
+            return !modifier_bit(scan) && scan != std_key_device_0 && scan != std_key_device_1;
+        }
+
+        static std::uint32_t modifier_bit(std::uint32_t scan) {
+            switch (scan) {
+            case std_key_left_shift: return event_modifier_left_shift;
+            case std_key_right_shift: return event_modifier_right_shift;
+            case std_key_left_ctrl: return event_modifier_left_ctrl;
+            case std_key_right_ctrl: return event_modifier_right_ctrl;
+            case std_key_left_alt: return event_modifier_left_alt;
+            case std_key_right_alt: return event_modifier_right_alt;
+            default: return 0;
+            }
+        }
+
+        // The ASCII keyboard profile supplies standard A-Z scan codes. Native
+        // editing commands use C0 control codes while retaining the physical
+        // scan, so Ctrl+H/I/M remain distinguishable from Backspace/Tab/Enter.
+        // This is not a host keyboard layout or an AltGr text translator.
+        std::uint32_t key_code_for_scan(std::uint32_t scan) const {
+            auto code = static_cast<std::uint32_t>(map_scancode_to_keycode(static_cast<std_scan_code>(scan)));
+            if (code >= 'A' && code <= 'Z') {
+                if ((modifiers_ & event_modifier_ctrl) && !(modifiers_ & event_modifier_alt))
+                    return code - 'A' + 1;
+                if (!(modifiers_ & event_modifier_shift))
+                    return code - 'A' + 'a';
+            }
+            return code;
         }
 
         std::optional<event> translate(event &raw) {
             const auto scan = static_cast<std_scan_code>(raw.key_evt_.scancode);
-            if (is_shift(scan)) {
-                const auto bit = scan == std_key_left_shift ? event_modifier_left_shift : event_modifier_right_shift;
+            const auto bit = modifier_bit(scan);
+            if (bit) {
                 if (raw.type == event_code::key_down) {
                     modifiers_ |= bit;
                 } else if (raw.type == event_code::key_up) {
                     modifiers_ &= ~bit;
                 }
-                modifiers_ &= ~event_modifier_shift;
-                if (modifiers_ & (event_modifier_left_shift | event_modifier_right_shift)) {
+                modifiers_ &= ~(event_modifier_shift | event_modifier_ctrl | event_modifier_alt);
+                if (modifiers_ & (event_modifier_left_shift | event_modifier_right_shift))
                     modifiers_ |= event_modifier_shift;
-                }
+                if (modifiers_ & (event_modifier_left_ctrl | event_modifier_right_ctrl))
+                    modifiers_ |= event_modifier_ctrl;
+                if (modifiers_ & (event_modifier_left_alt | event_modifier_right_alt))
+                    modifiers_ |= event_modifier_alt;
             }
 
             raw.key_evt_.modifiers = modifiers_;
             // WSERV reports modifier transitions through key up/down, never EEventKey.
-            if (is_shift(scan) || raw.type != event_code::key_down) {
+            if (bit || raw.type != event_code::key_down) {
                 return std::nullopt;
             }
 
             event key = raw;
             key.type = event_code::key;
-            key.key_evt_.code = map_scancode_to_keycode(scan);
+            key.key_evt_.code = key_code_for_scan(scan);
             if (is_repeatable(scan)) {
                 key.key_evt_.modifiers |= event_modifier_repeatable;
             }
diff --git a/src/emu/services/src/window/window.cpp b/src/emu/services/src/window/window.cpp
index 2974ed0..62336ed 100644
--- a/src/emu/services/src/window/window.cpp
+++ b/src/emu/services/src/window/window.cpp
@@ -2363,7 +2363,6 @@ namespace eka2l1 {
         repeatable_event_ = kern->get_ntimer()->register_event("WsRepeatableKeyEvent",
             [this](std::uint64_t data, std::uint64_t microsecs_late) {
                 const std::uint32_t scancode = static_cast<std::uint32_t>(data);
-                const std::uint32_t code = static_cast<std::uint32_t>(data >> 32);
 
                 epoc::event repeatable_evt;
                 ntimer *timing = kern->get_ntimer();
@@ -2375,7 +2374,8 @@ namespace eka2l1 {
 
                     repeatable_evt.handle = get_focus()->client_handle;
                     repeatable_evt.time = kern->universal_time();
-                    repeatable_evt.key_evt_.code = code;
+                    // A modifier may change while this key remains held.
+                    repeatable_evt.key_evt_.code = key_shipper.translator_.key_code_for_scan(scancode);
                     repeatable_evt.key_evt_.scancode = scancode;
                     repeatable_evt.key_evt_.repeats = 1;
 
diff --git a/src/tests/epoc/services/window/keyboard.cpp b/src/tests/epoc/services/window/keyboard.cpp
index db3691f..bcadad0 100644
--- a/src/tests/epoc/services/window/keyboard.cpp
+++ b/src/tests/epoc/services/window/keyboard.cpp
@@ -76,3 +76,75 @@ TEST_CASE("Releasing either Shift preserves the other held Shift", "[window][key
     translator.translate(right);
     REQUIRE(right.key_evt_.modifiers == 0);
 }
+
+TEST_CASE("Control and Alt transitions are modifiers rather than repeatable characters", "[window][keyboard]") {
+    for (auto scan : {std_key_left_ctrl, std_key_right_ctrl, std_key_left_alt, std_key_right_alt}) {
+        key_event_translator translator;
+        auto down = raw_key(scan, true);
+        REQUIRE_FALSE(translator.translate(down));
+        REQUIRE_FALSE(translator.is_repeatable(scan));
+        REQUIRE(down.key_evt_.code == 0);
+        REQUIRE(translator.modifiers() & key_event_translator::modifier_bit(scan));
+        REQUIRE(translator.modifiers() & (scan == std_key_left_ctrl || scan == std_key_right_ctrl ? event_modifier_ctrl : event_modifier_alt));
+        auto up = raw_key(scan, false);
+        REQUIRE_FALSE(translator.translate(up));
+        REQUIRE(up.key_evt_.modifiers == 0);
+    }
+}
+
+TEST_CASE("Control and Alt aggregates retain the other held side", "[window][keyboard]") {
+    for (auto pair : {std::pair{std_key_left_ctrl, std_key_right_ctrl}, std::pair{std_key_left_alt, std_key_right_alt}}) {
+        key_event_translator translator;
+        auto left = raw_key(pair.first, true), right = raw_key(pair.second, true);
+        translator.translate(left); translator.translate(right);
+        left.type = event_code::key_up;
+        translator.translate(left);
+        const auto aggregate = pair.first == std_key_left_ctrl ? event_modifier_ctrl : event_modifier_alt;
+        REQUIRE(translator.modifiers() == (key_event_translator::modifier_bit(pair.second) | aggregate));
+        right.type = event_code::key_up;
+        translator.translate(right);
+        REQUIRE(translator.modifiers() == 0);
+    }
+}
+
+TEST_CASE("ASCII profile generates control letters without rewriting special scans", "[window][keyboard]") {
+    key_event_translator translator;
+    auto ctrl = raw_key(std_key_left_ctrl, true); translator.translate(ctrl);
+    for (std::uint32_t scan = 'A'; scan <= 'Z'; ++scan) {
+        auto down = raw_key(static_cast<std_scan_code>(scan), true);
+        auto key = translator.translate(down);
+        REQUIRE(key);
+        REQUIRE(key->key_evt_.scancode == scan);
+        REQUIRE(key->key_evt_.code == scan - 'A' + 1);
+        REQUIRE(key->key_evt_.modifiers == (event_modifier_ctrl | event_modifier_left_ctrl | event_modifier_repeatable));
+        REQUIRE(down.key_evt_.code == 0);
+        auto up = raw_key(static_cast<std_scan_code>(scan), false);
+        REQUIRE_FALSE(translator.translate(up));
+    }
+    for (auto scan : {std_key_backspace, std_key_tab, std_key_enter, std_key_right_arrow, std_key_device_0}) {
+        auto down = raw_key(scan, true);
+        auto key = translator.translate(down);
+        REQUIRE(key);
+        REQUIRE(key->key_evt_.scancode == scan);
+        REQUIRE(key->key_evt_.code == static_cast<std::uint32_t>(map_scancode_to_keycode(scan)));
+    }
+}
+
+TEST_CASE("ASCII letters follow Shift while control and repeats sample current modifiers", "[window][keyboard]") {
+    key_event_translator translator;
+    REQUIRE(translator.key_code_for_scan('V') == 'v');
+    auto shift = raw_key(std_key_right_shift, true); translator.translate(shift);
+    REQUIRE(translator.key_code_for_scan('V') == 'V');
+    auto ctrl = raw_key(std_key_right_ctrl, true); translator.translate(ctrl);
+    REQUIRE(translator.key_code_for_scan('V') == 22);
+    // Same held letter/scan, but repeat delivery must follow the current state.
+    ctrl.type = event_code::key_up; translator.translate(ctrl);
+    REQUIRE(translator.key_code_for_scan('V') == 'V');
+    shift.type = event_code::key_up; translator.translate(shift);
+    REQUIRE(translator.key_code_for_scan('V') == 'v');
+    auto alt = raw_key(std_key_left_alt, true); translator.translate(alt);
+    ctrl.type = event_code::key_down; translator.translate(ctrl);
+    // Ctrl+Alt is not a C0 shortcut or a pretend AltGr layout conversion.
+    REQUIRE(translator.key_code_for_scan('V') == 'v');
+    REQUIRE(translator.modifiers() == (event_modifier_left_alt | event_modifier_alt | event_modifier_right_ctrl | event_modifier_ctrl));
+}
