# Only WebCore for now; the API layer and the shell come later.
set(ENABLE_WEBCORE ON)
set(ENABLE_WEBKIT_LEGACY OFF)
set(ENABLE_WEBKIT OFF)
set(ENABLE_WEBINSPECTORUI OFF)

set(bmalloc_LIBRARY_TYPE STATIC)
set(WTF_LIBRARY_TYPE STATIC)
set(JavaScriptCore_LIBRARY_TYPE STATIC)
set(PAL_LIBRARY_TYPE STATIC)
set(WebCore_LIBRARY_TYPE STATIC)

SET_AND_EXPOSE_TO_BUILD(USE_GENERIC_EVENT_LOOP 1)
SET_AND_EXPOSE_TO_BUILD(WTF_DEFAULT_EVENT_LOOP 0)
SET_AND_EXPOSE_TO_BUILD(USE_CAIRO ON)
SET_AND_EXPOSE_TO_BUILD(USE_CURL ON)
SET_AND_EXPOSE_TO_BUILD(USE_FREETYPE ON)
SET_AND_EXPOSE_TO_BUILD(USE_HARFBUZZ ON)
SET_AND_EXPOSE_TO_BUILD(USE_MBEDTLS ON)

set(WTF_FRAMEWORK_HEADERS_DIR ${CMAKE_BINARY_DIR}/WTF/Headers)
set(JavaScriptCore_FRAMEWORK_HEADERS_DIR ${CMAKE_BINARY_DIR}/JavaScriptCore/Headers)
set(JavaScriptCore_PRIVATE_FRAMEWORK_HEADERS_DIR ${CMAKE_BINARY_DIR}/JavaScriptCore/PrivateHeaders)
set(PAL_FRAMEWORK_HEADERS_DIR ${CMAKE_BINARY_DIR}/PAL/Headers)
set(WebCore_PRIVATE_FRAMEWORK_HEADERS_DIR ${CMAKE_BINARY_DIR}/WebCore/PrivateHeaders)

find_package(ICU 60.2 REQUIRED COMPONENTS data i18n uc)
find_package(Cairo 1.16 REQUIRED)
find_package(Fontconfig 2.8.0 REQUIRED)
find_package(Freetype 2.4.2 REQUIRED)
find_package(HarfBuzz 2.7 REQUIRED COMPONENTS ICU)
find_package(CURL 7.84 REQUIRED)
find_package(JPEG REQUIRED)
find_package(LibXml2 2.8.0 REQUIRED)
find_package(PNG REQUIRED)
find_package(SQLite3 REQUIRED)
find_package(WebP REQUIRED COMPONENTS demux)
find_package(ZLIB REQUIRED)

# TLS and digests: the SDK's mbedTLS (static libraries).
set(MBEDTLS_INCLUDE_DIR "${SYMBIAN_SDK_PREFIX}/lib/armv6/mbedtls/include")
set(MBEDTLS_LIBRARY "${SYMBIAN_SDK_PREFIX}/lib/armv6/mbedtls/lib/libmbedtls.a")
set(MBEDX509_LIBRARY "${SYMBIAN_SDK_PREFIX}/lib/armv6/mbedtls/lib/libmbedx509.a")
set(MBEDCRYPTO_LIBRARY "${SYMBIAN_SDK_PREFIX}/lib/armv6/mbedtls/lib/libmbedcrypto.a")
